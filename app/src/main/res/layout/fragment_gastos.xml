<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- El selector conserva TabLayout/ViewPager2 y adopta una lectura segmentada. -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout_gastos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_tab_container"
            android:clipToPadding="false"
            android:padding="4dp"
            app:tabBackground="@drawable/bg_tab"
            app:tabIndicatorHeight="0dp"
            app:tabMode="fixed"
            app:tabPaddingEnd="12dp"
            app:tabPaddingStart="12dp"
            app:tabRippleColor="@color/color_accent_ripple"
            app:tabTextColor="@color/tab_text_colors" />

        <!-- Cada página crea su propio Fragment hijo con la lista correspondiente. -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager_gastos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- El espacio inferior de cada lista deja sitio para este FAB superpuesto. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_agregar_gasto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/descripcion_agregar_gasto"
        android:elevation="4dp"
        app:backgroundTint="@color/color_accent"
        app:borderWidth="0dp"
        app:rippleColor="@color/color_accent_ripple"
        app:srcCompat="@drawable/ic_agregar"
        app:tint="@color/color_text_on_accent" />
</FrameLayout>

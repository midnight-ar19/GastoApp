<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- El espacio inferior evita que el FAB tape la última fila de ingresos. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista_ingresos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="112dp" />

    <!-- El botón abre el formulario de alta con tipo INGRESO inferido por la sección. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_agregar_ingreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/descripcion_agregar_ingreso"
        android:elevation="4dp"
        app:backgroundTint="@color/color_accent"
        app:borderWidth="0dp"
        app:rippleColor="@color/color_accent_ripple"
        app:srcCompat="@drawable/ic_agregar"
        app:tint="@color/color_text_on_accent" />
</FrameLayout>
